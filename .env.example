# Local development defaults only. Do not use these credentials in deployment.
APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_DB=airline
POSTGRES_USER=airline
POSTGRES_PASSWORD=airline_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://airline:airline_local@localhost:5432/airline
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
KNOWLEDGE_DIR=knowledge
# Set a shared secret before exposing booking or webhook endpoints publicly.
AGENT_API_KEY=
# Optional fixed business clock for the November sample week; audit time stays real.
# SIMULATION_NOW=2026-11-06T12:00:00Z
DASHBOARD_PORT=3000

# ElevenLabs provisioning: keep API credentials server-side.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Public HTTPS booking API origin; temporary tunnels change on restart.
PUBLIC_API_BASE_URL=
# Reserved for future post-call event signature verification.
ELEVENLABS_WEBHOOK_SECRET=

# Autonomous refinement. Model credentials stay server-side; all three roles use REST.
REFINER_MODEL_API_KEY=
# OPENAI_API_KEY can also supply the model key when REFINER_MODEL_API_KEY is unset.
REFINER_MODEL_BASE_URL=https://api.openai.com/v1
REFINER_API_BASE_URL=http://localhost:8000
REFINER_ARTIFACTS_DIR=artifacts
REFINER_CONFIG_PATH=config/refinement.example.toml
