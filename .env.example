# Local development defaults only. Do not use these credentials in deployment.
APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_DB=airline
POSTGRES_USER=airline
POSTGRES_PASSWORD=airline_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://airline:airline_local@localhost:5432/airline
# Test role needs CREATE DATABASE. Regression fixtures create/drop separate random databases.
TEST_DATABASE_URL=postgresql+asyncpg://airline:airline_local@localhost:5432/airline
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
KNOWLEDGE_DIR=knowledge
# Set a shared secret before exposing booking or webhook endpoints publicly.
AGENT_API_KEY=
# Fixed demo business clock keeps the November sample week usable; audit time stays real.
SIMULATION_NOW=2026-11-06T12:00:00Z
DASHBOARD_PORT=3000

# ElevenLabs provisioning: keep API credentials server-side.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Public HTTPS booking API origin; temporary tunnels change on restart.
PUBLIC_API_BASE_URL=

# Autonomous refinement. All three model roles use Anthropic's Messages REST API.
ANTHROPIC_API_KEY=
# Optional worker-specific Anthropic key when ANTHROPIC_API_KEY is unset.
REFINER_MODEL_API_KEY=
REFINER_MODEL_BASE_URL=https://api.anthropic.com/v1
REFINER_API_BASE_URL=http://localhost:8000
REFINER_ARTIFACTS_DIR=artifacts
REFINER_CONFIG_PATH=config/refinement.example.toml
