# Local development defaults only. Do not use these credentials in deployment.
APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_DB=airline
POSTGRES_USER=airline
POSTGRES_PASSWORD=airline_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://airline:airline_local@localhost:5432/airline
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
DASHBOARD_PORT=3000

# Server-side integrations; intentionally unused until adapters are implemented.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Refinement configuration; thresholds and execution policies are not defined yet.
REFINER_API_BASE_URL=http://localhost:8000
REFINER_ARTIFACTS_DIR=artifacts
REFINER_CONFIG_PATH=config/refinement.example.toml
